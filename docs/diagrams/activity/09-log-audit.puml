@startuml
' Use Case 09 - Log Audit (Staff/Owner)
skinparam backgroundColor #FFFFFF
skinparam activityBorderColor #333333
skinparam activityBackgroundColor #F8F8F8
skinparam activityBorderThickness 2
skinparam arrowThickness 2
skinparam swimlaneBorderColor #444444
skinparam swimlaneTitleBackgroundColor #E0E0E0
skinparam swimlaneTitleFontSize 14
skinparam swimlaneTitleFontStyle bold
skinparam defaultTextColor #222222

|Staff/Owner|
start
:Login ke sistem;
:Buka menu Log Audit;

|Sistem|
:Tampilkan daftar aktivitas\nsistem (urut waktu\ndescending);
|Staff/Owner|
:Lihat riwayat aktivitas:\n- Login/logout user\n- Hapus data\n- Trigger worker\n- dll;

if (Ada log yang\nperlu dihapus?) then (Ya)
  :Pilih log audit\nyang akan dihapus;
  :Konfirmasi penghapusan;

  |Sistem|
  :Hapus log audit\ndari database;
  :Catat audit:\n"Log audit dihapus\noleh Staff/Owner";
  :Tampilkan konfirmasi;
else (Tidak)
  :Selesai melihat log;
endif
stop
@enduml
